{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "nodenext",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "auth.mjs",
    "diagnostics.mjs",
    "cdp.mjs",
    "login-flow.mjs"
  ]
}
