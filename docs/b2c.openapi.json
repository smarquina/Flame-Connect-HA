{
  "openapi": "3.1.0",
  "info": {
    "title": "Flame Connect — Azure B2C",
    "version": "2.24.2-lab.1",
    "description": "Public-client flow with PKCE S256. Enter passwords only on the hosted B2C page. This contract has no custom username/password endpoint. No client_secret."
  },
  "servers": [
    {
      "url": "https://gdhvb2cflameconnect.b2clogin.com"
    }
  ],
  "paths": {
    "/gdhvb2cflameconnect.onmicrosoft.com/{policy}/oauth2/v2.0/authorize": {
      "get": {
        "operationId": "authorize",
        "parameters": [
          {
            "name": "policy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "B2C_1A_FirePhoneSignUpOrSignInWithPhoneOrEmail",
                "B2C_1A_FirePhoneSignInSocialOnly"
              ],
              "default": "B2C_1A_FirePhoneSignUpOrSignInWithPhoneOrEmail"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1af761dc-085a-411f-9cb9-53e5e2115bd2"
          },
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "msal1af761dc-085a-411f-9cb9-53e5e2115bd2://auth"
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "openid profile offline_access https://gdhvb2cflameconnect.onmicrosoft.com/Mobile/read"
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nonce",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "S256"
              ]
            }
          },
          {
            "name": "ui_locales",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "es"
          },
          {
            "name": "response_mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "query"
              ]
            },
            "example": "query"
          },
          {
            "name": "client-request-id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Open as browser navigation. code_challenge = BASE64URL(SHA256(code_verifier)). Validate state and nonce; redeem the code only once. Chrome follows the official form and its cookies/headers; the laboratory does not perform direct password login.",
        "responses": {
          "200": {
            "description": "Login page hosted by B2C."
          },
          "302": {
            "description": "Login redirects and return to redirect_uri with code and state, or an error."
          },
          "400": {
            "description": "Request or login form rejected."
          }
        }
      }
    },
    "/gdhvb2cflameconnect.onmicrosoft.com/{policy}/oauth2/v2.0/token": {
      "post": {
        "operationId": "exchangeOrRefresh",
        "parameters": [
          {
            "name": "policy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "B2C_1A_FirePhoneSignUpOrSignInWithPhoneOrEmail",
                "B2C_1A_FirePhoneSignInSocialOnly"
              ],
              "default": "B2C_1A_FirePhoneSignUpOrSignInWithPhoneOrEmail"
            }
          },
          {
            "name": "client-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Server-side POST; Content-Type application/x-www-form-urlencoded and Accept application/json. No client_secret. The client omits Origin when exchanging the native return. Verify RS256 signatures using JWKS, issuer, and expiry; also verify audience and nonce for the initial ID token. Keep policy and optional headers consistent with login.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AuthorizationCodeForm"
                  },
                  {
                    "$ref": "#/components/schemas/RefreshForm"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens returned by B2C. Do not log their values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid code/verifier, rejected refresh token, or another OAuth error. If renewal fails, sign in again."
          }
        }
      }
    },
    "/gdhvb2cflameconnect.onmicrosoft.com/{policy}/v2.0/.well-known/openid-configuration": {
      "get": {
        "operationId": "openidConfiguration",
        "parameters": [
          {
            "name": "policy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "B2C_1A_FirePhoneSignUpOrSignInWithPhoneOrEmail",
                "B2C_1A_FirePhoneSignInSocialOnly"
              ],
              "default": "B2C_1A_FirePhoneSignUpOrSignInWithPhoneOrEmail"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OIDC metadata: issuer, authorization_endpoint, token_endpoint, and jwks_uri. Verify JWTs using the published public keys.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizationCodeForm": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "const": "1af761dc-085a-411f-9cb9-53e5e2115bd2"
          },
          "scope": {
            "type": "string",
            "example": "openid profile offline_access https://gdhvb2cflameconnect.onmicrosoft.com/Mobile/read"
          },
          "grant_type": {
            "const": "authorization_code",
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string",
            "const": "msal1af761dc-085a-411f-9cb9-53e5e2115bd2://auth"
          },
          "code_verifier": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128
          }
        },
        "required": [
          "client_id",
          "scope",
          "grant_type",
          "code",
          "redirect_uri",
          "code_verifier"
        ],
        "additionalProperties": true
      },
      "RefreshForm": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "const": "1af761dc-085a-411f-9cb9-53e5e2115bd2"
          },
          "scope": {
            "type": "string",
            "example": "openid profile offline_access https://gdhvb2cflameconnect.onmicrosoft.com/Mobile/read"
          },
          "grant_type": {
            "const": "refresh_token",
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "scope",
          "grant_type",
          "refresh_token"
        ],
        "additionalProperties": true
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "scope": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string",
            "description": "Use the rotated token if returned; otherwise retain the previous refresh token."
          },
          "id_token": {
            "type": "string",
            "description": "Identity token; do not use as the API Bearer token."
          }
        },
        "required": [
          "access_token",
          "token_type"
        ],
        "additionalProperties": true
      }
    }
  }
}
